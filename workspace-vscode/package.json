{
  "name": "trelix-vscode",
  "displayName": "trelix — Code Intelligence",
  "description": "Natural language code search and Q&A for your codebase via trelix",
  "version": "0.3.0",
  "publisher": "trelix",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["AI", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "trelix.search",
        "title": "trelix: Search Codebase"
      },
      {
        "command": "trelix.ask",
        "title": "trelix: Ask about Code"
      },
      {
        "command": "trelix.findSimilar",
        "title": "trelix: Find Similar Code"
      },
      {
        "command": "trelix.blastRadius",
        "title": "trelix: Show Blast Radius"
      }
    ],
    "chatParticipants": [
      {
        "id": "trelix.chat",
        "name": "trelix",
        "description": "Ask trelix about this codebase",
        "isSticky": true,
        "commands": [
          {
            "name": "search",
            "description": "Semantic code search across the codebase"
          },
          {
            "name": "explain",
            "description": "Explain the selected code"
          },
          {
            "name": "impact",
            "description": "Show what depends on a symbol (blast radius)"
          }
        ]
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "trelix.findSimilar",
          "when": "false"
        },
        {
          "command": "trelix.blastRadius",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "trelix",
      "properties": {
        "trelix.indexPath": {
          "type": "string",
          "default": "",
          "description": "Path to trelix-indexed repository (defaults to workspace root)"
        },
        "trelix.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show trelix code lenses (Find similar, blast radius) above symbols"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node ./dist/test/runTest.js",
    "test:unit": "npm run build && mocha --require ./dist/test/headless-boot.js --ui tdd dist/test/suite/mcp-client.test.js dist/test/suite/search-controller.test.js dist/test/suite/code-lens-provider.test.js dist/test/suite/chat-handler.test.js dist/test/suite/hover-provider.test.js",
    "package": "vsce package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^2.0.0",
    "esbuild": "^0.28.1",
    "glob": "^13.0.6",
    "mocha": "^11.7.6",
    "typescript": "^5.0.0"
  }
}
