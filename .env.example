# ---------------------------------------------------------------------------
# trelix — environment configuration
# Copy to .env and fill in the values you need.
# Never commit .env.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Embeddings provider (TRELIX_EMBEDDER_PROVIDER)
# Default: local (no API key needed)
# Options: local | openai | azure | voyage | local-code | bedrock-titan | bedrock-cohere
# ---------------------------------------------------------------------------
TRELIX_EMBEDDER_PROVIDER=local

# ── OpenAI embeddings ────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# TRELIX_EMBEDDER_OPENAI_MODEL=text-embedding-3-large

# ── Azure OpenAI embeddings + chat ──────────────────────────────────────────
# AZURE_API_KEY=...
# AZURE_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2025-04-01-preview
# AZURE_EMBEDDINGS_MODEL=text-embedding-3-large
# AZURE_CHAT_MODEL=gpt-4o

# ── Voyage AI embeddings (best API-based code retrieval — pip install trelix[voyage])
# CoIR benchmark: 56.26 avg — best API option for code retrieval
# VOYAGE_API_KEY=...
# TRELIX_EMBEDDER_VOYAGE_MODEL=voyage-code-3    # 1024-dim, 16k context

# ── Local sentence-transformers embeddings (no API key, CPU) ─────────────────
# Enabled by default when TRELIX_EMBEDDER_PROVIDER=local
# No additional variables required.

# ── Local code-specialized embeddings (SFR-Embedding-Code-2B_R, ~8GB RAM/GPU)
# pip install trelix[local-code]
# TRELIX_EMBEDDER_PROVIDER=local-code

# ---------------------------------------------------------------------------
# LLM provider for chat/synthesis (TRELIX_LLM_PROVIDER)
# Default: reads OPENAI_API_KEY / AZURE_API_KEY from above
# Options: openai | azure | anthropic | bedrock | vertex | litellm
# ---------------------------------------------------------------------------
# TRELIX_LLM_PROVIDER=openai
# TRELIX_LLM_MODEL=gpt-4o
# OPENAI_MODEL=gpt-4o                           # chat model for planner + synthesizer

# ── Anthropic direct (pip install trelix[anthropic]) ─────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── AWS Bedrock — chat + embeddings (pip install trelix[bedrock]) ─────────────
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_PROFILE=my-profile                        # alternative to key/secret
#
# Bedrock chat model selection (inference profile IDs — us.* prefix required):
# TRELIX_LLM_BEDROCK_PRIMARY_MODEL=us.anthropic.claude-sonnet-4-6
# TRELIX_LLM_BEDROCK_FALLBACK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
#
# Bedrock embeddings:
# TRELIX_EMBEDDER_PROVIDER=bedrock-titan        # 256 | 512 | 1024 dims
# TRELIX_EMBEDDER_PROVIDER=bedrock-cohere       # 1024 dims, asymmetric retrieval

# ── Google Vertex AI / Gemini (pip install trelix[vertex]) ────────────────────
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_API_KEY=...                            # for AI Studio (alternative to project)

# ── LiteLLM passthrough — 100+ providers (pip install trelix[litellm]) ────────
# TRELIX_LLM_PROVIDER=litellm
# TRELIX_LLM_LITELLM_MODEL=bedrock/claude-3-5-sonnet  # any LiteLLM model string

# ---------------------------------------------------------------------------
# Cohere reranker (optional, best precision — pip install trelix[rerank])
# ---------------------------------------------------------------------------
# COHERE_API_KEY=...
# COHERE_ENDPOINT=https://...                   # Azure-deployed Cohere endpoint
# COHERE_MODEL_RERANK=Cohere-rerank-v4.0-pro

# ---------------------------------------------------------------------------
# Contextual chunking (LLM summaries per chunk, 67% better recall)
# Costs LLM tokens at index time; off by default
# ---------------------------------------------------------------------------
# TRELIX_CHUNKER_CONTEXTUAL=false
# TRELIX_CHUNKER_CONTEXTUAL_MODEL=gpt-4o-mini
# TRELIX_CHUNKER_CONTEXTUAL_MAX_TOKENS=100

# Multi-granularity sub-symbol indexing (MGS3) — index block- and
# statement-level chunks too. Prerequisite for TRELIX_RETRIEVAL_SUB_CHUNK.
# TRELIX_CHUNKER_MULTI_GRANULARITY=false

# ---------------------------------------------------------------------------
# Store / vector DB
# Default: sqlite (zero-infra). Use qdrant for >500k chunk scale.
# ---------------------------------------------------------------------------
# TRELIX_STORE_BACKEND=sqlite                   # sqlite | qdrant
# TRELIX_STORE_HNSW=true                        # enable HNSW O(log n) index
# TRELIX_STORE_HNSW_M=16
# TRELIX_STORE_HNSW_EF_SEARCH=50

# Qdrant (pip install trelix[qdrant])
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=...
# QDRANT_COLLECTION=trelix

# ---------------------------------------------------------------------------
# Retrieval tuning
# ---------------------------------------------------------------------------
# TRELIX_RETRIEVAL_RERANK=true                  # master switch; set false to skip reranking
# `none` is NOT an accepted provider — the field is a Literal and any other
# value fails validation at startup. Disable reranking with RERANK=false above.
# `xtr` is degenerate — it returns every input score unchanged and never reads
# the query. Use `plaid` for real late interaction.
# TRELIX_RETRIEVAL_RERANK_PROVIDER=cohere       # cohere | cross_encoder | plaid | xtr
# TRELIX_RETRIEVAL_RERANK_TOP_N=15
# TRELIX_RETRIEVAL_CONTEXT_TOKEN_BUDGET=12000   # or null/none/auto to derive from the model window
# TRELIX_RETRIEVAL_SYNTHESIS_MAX_TOKENS=12000
# INERT: declared in RetrievalConfig, read nowhere in src/. Import expansion
# takes its cap from the per-intent RetrievalStrategy.import_max_extra table in
# retrieval/planner/models.py, which that file calls the ONLY place controlling
# per-intent retrieval behaviour.
# TRELIX_RETRIEVAL_GRAPH_IMPORT_MAX_EXTRA=3

# GraphRAG map-reduce synthesis
# Activates when results exceed either threshold
# TRELIX_RETRIEVAL_GRAPH_RAG=true
# TRELIX_RETRIEVAL_GRAPH_RAG_THRESHOLD_TOKENS=8000
# TRELIX_RETRIEVAL_GRAPH_RAG_THRESHOLD_RESULTS=20

# ---------------------------------------------------------------------------
# Extra retrieval legs (each is off by default and additive)
# ---------------------------------------------------------------------------
# Sparse SPLADE leg. The default model is CC BY-NC-SA-4.0 (non-commercial) and
# must be a BERT-family MaskedLM checkpoint — see docs/PROVIDERS.md before
# enabling this in a commercial deployment. pip install trelix[sparse]
# TRELIX_RETRIEVAL_SPARSE=false
# TRELIX_RETRIEVAL_SPARSE_TOP_K=20
# TRELIX_SPARSE_MODEL=naver/splade-v3-distilbert
# TRELIX_SPARSE_TOP_K_TOKENS=128                # 16-512
# TRELIX_SPARSE_BATCH_SIZE=16

# Sub-symbol (MGS3) leg — needs TRELIX_CHUNKER_MULTI_GRANULARITY at index time
# TRELIX_RETRIEVAL_SUB_CHUNK=false
# TRELIX_RETRIEVAL_SUB_CHUNK_TOP_K=10

# File-summary leg — needs TRELIX_FILE_SUMMARIES_ENABLED at index time, or it
# retrieves against an empty table
# TRELIX_RETRIEVAL_FILE_SUMMARY_LEG=false
# TRELIX_RETRIEVAL_FILE_SUMMARY_TOP_K=5

# CodeGraph BFS leg. MEASURED HARMFUL — LEAVE FALSE. On this project's own
# 54-query golden set, enabling it costs -0.2084 nDCG@10 on one query-plan draw
# and -0.2322 on a second independent draw (MRR -0.28/-0.31), moving 34-35 of the
# 54 queries. That is 3.4-3.8x the +/-0.061-0.080 run-to-run detection band, and
# it replicates in sign and magnitude — the largest single retrieval effect
# measured anywhere in the pipeline, and its sign is negative. Cause: graph hits
# are scored 0.5**hop (0.5 at one hop) while post-fusion retrieval scores measure
# 0.016-0.029, and the merge unioning the fused/expansion/graph sets sorts by RAW
# score, so every graph hit outranks every retrieved result and graph hits take
# 411 of 540 top-10 slots. The reranker cannot undo it; it only truncates.
# Listed here — with the default that ships — because until this line existed
# there was no reference for the name at all, so a reader who had followed an
# older doc and wanted it OFF had nothing to search for. DEPTH and MAX_RESULTS
# are inert while ENABLED is false.
# TRELIX_RETRIEVAL_GRAPH_SEARCH_ENABLED=false
# TRELIX_RETRIEVAL_GRAPH_SEARCH_DEPTH=2
# TRELIX_RETRIEVAL_GRAPH_SEARCH_MAX_RESULTS=15

# ---------------------------------------------------------------------------
# Multi-query expansion (one extra LLM call per query)
# ---------------------------------------------------------------------------
# TRELIX_RETRIEVAL_MULTI_QUERY=false
# TRELIX_RETRIEVAL_MULTI_QUERY_COUNT=2          # 1-4 variants in addition to the original

# ---------------------------------------------------------------------------
# Context compression (SeleCom) — extractive, no LLM or network call
# ---------------------------------------------------------------------------
# Shrinks oversized bodies so results that would be dropped for not fitting the
# token budget are included in compressed form instead.
# TRELIX_RETRIEVAL_COMPRESSION=false
# TRELIX_RETRIEVAL_COMPRESSION_PROVIDER=extractive   # only accepted value
# TRELIX_RETRIEVAL_COMPRESSION_RATIO=0.45       # 0.1-1.0; fallback for unknown intents only
# TRELIX_RETRIEVAL_COMPRESSION_MIN_TOKENS=120   # below this, compression costs more than it saves
# Per-intent override, e.g. BLAST_RADIUS / SYMBOL_LOOKUP / FEATURE_FLOW:
# TRELIX_RETRIEVAL_COMPRESSION_RATIO_BLAST_RADIUS=0.5

# ---------------------------------------------------------------------------
# Agentic ReAct retrieval loop (multi-turn retrieve -> observe -> synthesize)
# ---------------------------------------------------------------------------
# Costs one LLM call per turn — the token budget, not the turn count, is what
# usually stops the loop.
# TRELIX_RETRIEVAL_AGENTIC=false
# TRELIX_RETRIEVAL_AGENT_MAX_TURNS=8            # 1-20
# TRELIX_RETRIEVAL_AGENT_TOKEN_BUDGET=6000      # min 1000
# TRELIX_RETRIEVAL_AGENT_SESSION_MAX_AGE_SECONDS=604800   # 7 days; 0 = never expire

# ---------------------------------------------------------------------------
# Extended thinking — TRELIX_LLM_PROVIDER=anthropic only
# ---------------------------------------------------------------------------
# Only anthropic_backend builds the `thinking` request block; openai, azure,
# bedrock, vertex and litellm all accept the flag and ignore it, so enabling it
# on those providers is silently a no-op. Anthropic also forces temperature=1.0
# when thinking is on, overriding TRELIX_LLM_TEMPERATURE.
# TRELIX_LLM_THINKING_ENABLED=false
# TRELIX_LLM_THINKING_BUDGET_TOKENS=4096

# ---------------------------------------------------------------------------
# Query embedding cache
# ---------------------------------------------------------------------------
# LRU cache for embed_query() — eliminates repeat API calls within a session.
# Default: 256 (covers a typical interactive session). Set to 0 to disable.
# TRELIX_RETRIEVAL_QUERY_CACHE_SIZE=256

# ---------------------------------------------------------------------------
# Indexing tuning
# ---------------------------------------------------------------------------
# TRELIX_PARSE_WORKERS=4                        # parallel parse threads
# TRELIX_EMBEDDER_EMBED_MAX_TOKENS_PER_BATCH=100000
# TRELIX_EMBEDDER_TPM_LIMIT=0                   # 0 = unlimited

# LLM file-level summaries at index time (RAPTOR-style). Costs LLM tokens per
# file; required before TRELIX_RETRIEVAL_FILE_SUMMARY_LEG has anything to search.
# TRELIX_FILE_SUMMARIES_ENABLED=false

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# Per-query rows in the local query_telemetry table (no network egress).
# TRELIX_TELEMETRY_ENABLED=false

# OpenTelemetry spans, one per retrieval leg, gen_ai.* semantic conventions
# (Development status upstream — attribute names may still shift).
# pip install trelix[otel]. Note the two exporter vars are the standard OTel
# names, NOT TRELIX_-prefixed.
# TRELIX_OTEL_ENABLED=false
# OTEL_SERVICE_NAME=trelix
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---------------------------------------------------------------------------
# Federation (multi-repo search)
# ---------------------------------------------------------------------------
# INERT: RetrievalConfig declares both, and nothing in src/ reads either. Run
# `trelix search-all` to federate — it does so regardless of the flag, and its
# FederatedRetriever(registry) call takes no arguments, so the worker pool is
# always the constructor's own default of 4. Listed here only so the names are
# recognisable in a config dump.
# TRELIX_FEDERATION_ENABLED=false
# TRELIX_FEDERATION_MAX_WORKERS=4
# Applied only by callers that thread it through — the out-of-tree trelix-mcp
# server does; the CLI leaves max_repos=None, i.e. unbounded.
# TRELIX_FEDERATION_MAX_REPOS=50

# ---------------------------------------------------------------------------
# Audit trail (HTTP API only — see docs/AUDIT.md)
# ---------------------------------------------------------------------------
# Writes a hash-chained trail to its OWN audit.db, separate from the index DB
# so it survives re-indexing. MCP tool calls, the agent loop, CLI commands and
# direct library use are NOT audited.
# TRELIX_AUDIT_ENABLED=false
# TRELIX_AUDIT_DB_PATH=                         # default: <cwd>/.trelix/audit.db
# TRELIX_AUDIT_FAIL_CLOSED=false                # true = an audit-write failure fails the request
# Inert on the HTTP path — `detail` is always null there, so raw query text is
# never stored regardless of this setting.
# TRELIX_AUDIT_LOG_QUERIES=false
# Not implemented: nothing reads it, there is no pruning job, and a negative
# value is accepted. Rotate or prune audit.db yourself.
# TRELIX_AUDIT_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# OIDC single sign-on for the HTTP API (pip install trelix[serve,sso])
# ---------------------------------------------------------------------------
# Loaded once in create_app(). enabled=false means no verifier is built and the
# API behaves exactly as with static-token/open auth.
# TRELIX_OIDC_ENABLED=false
# TRELIX_OIDC_ISSUER=https://your-idp.example.com/
# TRELIX_OIDC_AUDIENCE=trelix-api
# TRELIX_OIDC_JWKS_URI=https://your-idp.example.com/.well-known/jwks.json
# TRELIX_OIDC_JWKS_TTL_SECONDS=3600
# Asymmetric-only allowlist — the verifier rejects `alg: none` and every HS*
# variant, so a symmetric algorithm cannot be configured here.
# TRELIX_OIDC_ALGORITHMS=["RS256","ES256"]

# ---------------------------------------------------------------------------
# Connector credentials (trelix connector sync)
# ---------------------------------------------------------------------------
# Four independent connectors; configure only the ones you sync. All secrets
# below are placeholders — put real values in .env, never here.

# ── Jira ─────────────────────────────────────────────────────────────────────
# TRELIX_JIRA_BASE_URL=https://your-org.atlassian.net
# TRELIX_JIRA_EMAIL=you@example.com
# TRELIX_JIRA_API_TOKEN=                        # Atlassian API token
# TRELIX_JIRA_PROJECT_KEY=PROJ
# TRELIX_JIRA_PAGE_SIZE=100                     # 1-100

# ── Linear ───────────────────────────────────────────────────────────────────
# TRELIX_LINEAR_API_KEY=                        # lin_api_...
# TRELIX_LINEAR_TEAM_KEY=ENG
# TRELIX_LINEAR_PAGE_SIZE=100                   # 1-100

# ── Xray (test management on top of Jira — its own base URL) ─────────────────
# TRELIX_XRAY_JIRA_BASE_URL=https://your-org.atlassian.net
# TRELIX_XRAY_CLIENT_ID=
# TRELIX_XRAY_CLIENT_SECRET=
# TRELIX_XRAY_PROJECT_KEY=PROJ
# TRELIX_XRAY_PAGE_SIZE=100                     # 1-100

# ── TestRail ─────────────────────────────────────────────────────────────────
# TRELIX_TESTRAIL_BASE_URL=https://your-org.testrail.io
# TRELIX_TESTRAIL_USERNAME=you@example.com
# TRELIX_TESTRAIL_API_KEY=
# TRELIX_TESTRAIL_PROJECT_ID=1
# TRELIX_TESTRAIL_PAGE_SIZE=250                 # 1-250

# --- Retrieval breadth floor (v3.1.2) -------------------------------------
# A thin direct lookup used to suppress every other retrieval leg. The floor runs
# standard retrieval alongside it and merges. Set false for the old behaviour.
# TRELIX_RETRIEVAL_BREADTH_FLOOR=true
# TRELIX_RETRIEVAL_BREADTH_FLOOR_MIN_FILES=2
# TRELIX_RETRIEVAL_BREADTH_FLOOR_MIN_SYMBOLS=10
